<% provide(:title, "Course Registrations") %>
<section class="content-header">
  <div class="container-fluid">
    <div class="row mb-2">
      <div class="col-sm-6">
        <h1>Course Registrations</h1>
      </div>
      <div class="col-sm-6">
        <ol class="breadcrumb float-sm-right">
          <li class="breadcrumb-item"><a href="/">Home</a></li>
          <li class="breadcrumb-item active">Course Registrations</li>
        </ol>
      </div>
    </div>
  </div>
</section>

<section class="content">
  <div class="container-fluid">
    <div class="card">
      <div class="card-header bg-primary text-white">
        <h3 class="card-title">Course Registrations</h3>
      </div>
      <div class="card-body table-responsive p-0">
        <style>
          .table {
            border-collapse: collapse;
            width: 100%;
          }
          .table th, .table td {
            border: 1px solid #ddd;
            padding: 8px;
          }
          .table th {
            background-color: #f8f9fa;
            font-weight: bold;
            text-align: left;
          }
          .table-hover tbody tr:hover {
            background-color: #f1f1f1;
          }
          .table-striped tbody tr:nth-of-type(odd) {
            background-color: #f9f9f9;
          }
          .table-responsive {
            overflow-x: auto;
          }
        </style>
        <table class="table table-hover table-striped text-nowrap">
          <thead>
            <tr>
              <th>Student</th>
              <th>Course Title</th>
              <th>Enrollment Status</th>
              <th>Registration Date</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @course_registrations.each do |registration| %>
              <tr>
                <td><%= registration.student_full_name %></td>
                <td><%= registration.course_title %></td>
                <td>
                  <% if registration.enrollment_status == 'pending' %>
                    <span class="badge badge-warning"><%= registration.enrollment_status.titleize %></span>
                  <% elsif registration.enrollment_status == 'enrolled' %>
                    <span class="badge badge-success"><%= registration.enrollment_status.titleize %></span>
                  <% else %>
                    <span class="badge badge-secondary"><%= registration.enrollment_status.titleize %></span>
                  <% end %>
                </td>
                <td><%= registration.created_at.strftime("%B %d, %Y") %></td>
                <td>
                  <%= link_to 'Show', registration, class: 'btn btn-sm btn-info' %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
